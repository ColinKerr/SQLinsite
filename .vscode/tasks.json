{
    "version": "2.0.0",
    "tasks": [
        {
            // Configure a Debug build (-g, no optimization) in cmake-build-debug/
            // so breakpoints bind and stepping is clean. Kept separate from the
            // Release build/ dir. (cmake-build-* is git-ignored.)
            "label": "cmake: configure (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/cmake-build-debug",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            // Builds the C++ test binary for debugging; used as the launch.json
            // preLaunchTask so F5 always debugs a freshly-built debug binary.
            "label": "cmake: build tests (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/cmake-build-debug",
                "--target", "sqlinsite_tests", "-j"
            ],
            "dependsOn": "cmake: configure (debug)",
            "group": "build",
            "problemMatcher": [ "$gcc" ]
        },
        {
            // Builds the `sqlinsite` app binary (Debug, -g) in cmake-build-debug/.
            // Used as the preLaunchTask for the "visualize serve" debug configs, so
            // F5 always debugs a freshly-built binary. This also rebuilds and embeds
            // the front-end (needs Node/npm), so the served app is current.
            "label": "cmake: build sqlinsite (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/cmake-build-debug",
                "--target", "sqlinsite", "-j"
            ],
            "dependsOn": "cmake: configure (debug)",
            "group": "build",
            "problemMatcher": [ "$gcc" ]
        },
        {
            // Starts the Vite dev server (HMR + source maps) for debugging the
            // front-end. Used as the preLaunchTask for the "Frontend (Chrome)"
            // config. It's a long-running background task: the problemMatcher below
            // lets VS Code detect when the server is ready (prints "Local:") and
            // then launch the browser. Its `/api/*` calls proxy to a running C++
            // backend on :8080 (see web/vite.config.ts) — start one first (e.g. the
            // "visualize serve --db-file" config, or the full-stack compound).
            "label": "vite: dev server",
            "type": "shell",
            "command": "npm",
            "args": [ "run", "dev" ],
            "options": { "cwd": "${workspaceFolder}/web" },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE v.*",
                    "endsPattern": ".*Local:.*"
                }
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
